# 복사해서 사용: copy .env.example .env   (모든 값은 선택, 아래는 기본값)

# 웹 서버 포트
PORT=3000

# OCR 엔진: tesseract(Node 내장, 기본) | paddle(ocr-service 필요)
OCR_ENGINE=tesseract
# OCR_ENGINE=paddle 일 때 ocr-service 주소와 요청 제한 시간(ms)
OCR_SERVICE_URL=http://127.0.0.1:8000
OCR_SERVICE_TIMEOUT_MS=60000

# 이 값보다 신뢰도가 낮으면 REVIEW_REQUIRED
OCR_CONFIDENCE_THRESHOLD=0.75
# on 이면 전처리에 이진화(threshold) 적용
OCR_THRESHOLD=off

# ── 공개 데모용 제한 (로컬은 기본값 그대로 두면 지금처럼 동작) ─────────
# true 면 OCR 원문을 저장하지 않고, 처리 내역은 최근 DEMO_KEEP_LATEST건만 남긴다.
# documents 행이 DEMO_MAX_ROWS건 이상이면 새 저장을 거부한다
DEMO_MODE=false
DEMO_KEEP_LATEST=50
DEMO_MAX_ROWS=200
# false 면 파일 업로드를 막고 화면의 샘플만 처리한다
DEMO_UPLOAD=true

# ── MySQL 8.0 (필수) ─────────────────────────────────────────────
# 이 DB 하나만 사용한다. 테이블 만들기: npm run db:migrate
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ocr_pipeline
DB_USER=ocr_user
# 비밀번호는 .env 에만 쓴다 (이 파일에는 쓰지 말 것)
DB_PASSWORD=
# 암호화 연결. 로컬 MySQL은 false, TiDB Cloud는 true
DB_SSL=false
# 세션 시간대 (created_at 기준). 기본 +09:00
DB_TIMEZONE=+09:00
# 커넥션 풀 크기
DB_CONNECTION_LIMIT=5

# TiDB Cloud(무료 Serverless)로 옮길 때는 접속 정보 화면의 값으로 아래만 바꾼다
# DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=<prefix>.root
# DB_PASSWORD=
# DB_SSL=true

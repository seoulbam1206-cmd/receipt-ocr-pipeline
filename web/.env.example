# 복사해서 사용: copy .env.example .env   (모든 값은 선택, 아래는 기본값)

# 웹 서버 포트
PORT=3000

# OCR 엔진: tesseract(Node 내장, 기본) | paddle(ocr-service 필요)
OCR_ENGINE=tesseract
# OCR_ENGINE=paddle 일 때 ocr-service 주소와 요청 제한 시간(ms)
OCR_SERVICE_URL=http://127.0.0.1:8000
OCR_SERVICE_TIMEOUT_MS=60000

# 이 값보다 신뢰도가 낮으면 REVIEW_REQUIRED
OCR_CONFIDENCE_THRESHOLD=0.75
# on 이면 전처리에 이진화(threshold) 적용
OCR_THRESHOLD=off

# SQLite 파일 경로 (기본: web/data/receipts.db)
# DB_FILE=./data/receipts.db

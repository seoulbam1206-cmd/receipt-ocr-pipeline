# 복사해서 사용: copy .env.example .env
# 실행: .venv\Scripts\python -m uvicorn app.main:app --port 8000 --env-file .env
# 모든 값은 선택이며 아래는 기본값

OCR_LANG=korean
OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=korean_PP-OCRv5_mobile_rec
# paddlepaddle 3.3 CPU에서 oneDNN을 켜면 PP-OCRv5 추론이 실패해 기본 false
OCR_ENABLE_MKLDNN=false
OCR_MAX_UPLOAD_BYTES=10485760

# 모델 캐시 위치 (기본: ocr-service/.paddlex). 경로에 한글 등 비ASCII 문자가 있으면 안 됨
# PADDLE_PDX_CACHE_HOME=D:\models\paddlex
